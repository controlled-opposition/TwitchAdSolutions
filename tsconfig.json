{
    // Page bundle (src/page) plus the code it shares with the worker, against the DOM lib.
    // The worker is checked separately against the webworker lib: src/worker/tsconfig.json.
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "lib": ["es2022", "dom", "dom.iterable"]
    },
    "include": ["src/page", "src/shared"]
}
